# Optional real phone verification. Without these, the phone flow is clearly demo-only.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# Shared only between the local OpenClaw hook and this server-side webhook.
WHATSAPP_SYNC_SECRET=

# Shared secret for the multi-campaign allowlist/messages/handoff endpoints under /api/campaigns/**
CAMPAIGN_SYNC_SECRET=

# Google OAuth web application credentials. Keep the secret server-side only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Local pilot only: the laptop-hosted OpenClaw provisioning bridge.
ESTATE_DESK_RUNTIME_URL=http://127.0.0.1:18791
ESTATE_DESK_RUNTIME_SECRET=
