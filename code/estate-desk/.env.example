# The only WhatsApp contact this demo may process. Keep the real value out of Git.
ALLOWED_WHATSAPP_PHONE=+919999999999

# Optional real phone verification. Without these, the phone flow is clearly demo-only.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# Shared only between the local OpenClaw hook and this server-side webhook.
WHATSAPP_SYNC_SECRET=
